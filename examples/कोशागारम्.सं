# कोशागारम् — the standard library at work.
#
# One small program that does what real programs actually do: read a CSV,
# validate it, compute exact money, fingerprint the result, and log what
# happened. Nothing here needs an external library.
#
# चालनम् / run:  sanskrita examples/कोशागारम्.सं

आनय "सारणी"   इति सा।
आनय "सूचीकर्म" इति सू।
आनय "वाक्यकर्म" इति वाक।
आनय "कालः"     इति का।
आनय "गूढ"      इति गू।
आनय "जेसन"     इति ज।

# ---- आदानम् / the input, as it would arrive from a spreadsheet ----
मानय पाठः = "दिनाङ्कः,वस्तु,मूल्यम्
२०२६-०७-०१,पुस्तकम्,४५०.५०
२०२६-०७-०५,\"लेखनी, नीला\",१२०.२५
२०२६-०७-१८,चायः,८०.००
२०२६-०८-०२,सञ्चिका,३२०.७५
"।

मानय पङ्क्तयः = सा.कोशाः(पाठः)।
वद("पङ्क्तयः प्राप्ताः:", दैर्घ्यम्(पङ्क्तयः))।
वद("")।

# ---- परीक्षणम् / validate before trusting ----
# सारणी हर क्षेत्रं वाक्यरूपेण ददाति — सङ्ख्या स्वयं परिवर्तनीया।
# Every CSV field arrives as text. Converting is YOUR decision, not a silent
# one made by the parser — so a bad row is caught here, not three steps later.
प्रत्येकम् प इति पङ्क्तयः {
    यदि (न का.शुद्धः(प["दिनाङ्कः"])) {
        क्षिप वाक.आकारय("अशुद्धः दिनाङ्कः: {}", प["दिनाङ्कः"])।
    }
}
वद("सर्वे दिनाङ्काः शुद्धाः ✓")।

# ---- गणना / exact money, and dates that behave ----
मानय जुलै = सू.छानय(पङ्क्तयः, विधि(प) { फलम् का.मासः(प["दिनाङ्कः"]) == ७। })।
मानय मूल्यानि = सू.प्रतिचित्रय(जुलै, विधि(प) { फलम् सङ्ख्या(प["मूल्यम्"])। })।

वद("जुलै-मासस्य व्ययाः:", दैर्घ्यम्(जुलै))।
वद("योगः            :", सू.योगः(मूल्यानि))।
वद("महत्तमः         :", सू.महत्तमम्(मूल्यानि))।

# शुद्धिः — यदि प्लवः स्यात् तर्हि ६५०.७४९९... इति भवेत्
# Exactness: with binary floats this sum would drift. Here it does not.
वद("योगः शुद्धः वा  :", सू.योगः(मूल्यानि) == ६५०.७५)।
वद("")।

# ---- क्रमः / sort by whatever you like ----
मानय क्रमिताः = सू.क्रमय(पङ्क्तयः, विधि(प) { फलम् ०-सङ्ख्या(प["मूल्यम्"])। })।
वद("महत्तमात् आरभ्य:")।
प्रत्येकम् प इति क्रमिताः {
    वद(" ", वाक.आकारय("{} — {} ({})",
                      प["वस्तु"], प["मूल्यम्"], का.वासरः(प["दिनाङ्कः"])))।
}
वद("")।

# ---- कालगणना / date arithmetic ----
मानय प्रथमः = पङ्क्तयः[१]["दिनाङ्कः"]।
मानय अन्तिमः = पङ्क्तयः[दैर्घ्यम्(पङ्क्तयः)]["दिनाङ्कः"]।
वद("प्रथमात् अन्तिमं यावत्:", का.अन्तरम्(प्रथमः, अन्तिमः), "दिनानि")।
वद("त्रिंशद्दिनानन्तरम्     :", का.दिनयोगः(अन्तिमः, ३०))।
वद("")।

# ---- निर्गमः / hand the result on ----
मानय सारः = {
    "मासः": "२०२६-०७",
    "सङ्ख्या": दैर्घ्यम्(जुलै),
    "योगः": सू.योगः(मूल्यानि),
}।
मानय पत्रम् = ज.पाठय(सारः)।
वद("जेसन:", पत्रम्)।

# अङ्गुलिचिह्नम् — समानम् आदानं समानं चिह्नं ददाति
# A fingerprint: the same input always gives the same digest, so you can tell
# whether a file has changed without reading it twice.
वद("चिह्नम्:", वाक.अंश(गू.सङ्क्षेपः(पत्रम्), १, १६), "…")।

# ---- CSV पुनः / write it back out ----
वद("")।
वद("पुनः सारणीरूपेण:")।
वद(सा.पाठय([["वस्तु", "मूल्यम्"]] + सू.प्रतिचित्रय(जुलै,
    विधि(प) { फलम् [प["वस्तु"], प["मूल्यम्"]]। })))।
