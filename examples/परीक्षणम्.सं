मानय _कृतानि = ०।
मानय _विफलानि = ०।

# assert equality
विधि तुल्यम्(नाम, प्राप्तम्, अपेक्षितम्) {
    _कृतानि = _कृतानि + १।
    यदि (प्राप्तम् == अपेक्षितम्) {
        वद("  ✓", नाम)।
    } अन्यथा {
        _विफलानि = _विफलानि + १।
        वद("  ✗", नाम, "— अपेक्षितम्:", अपेक्षितम्, "प्राप्तम्:", प्राप्तम्)।
    }
}

# assert truth
विधि सत्यम्_अस्ति(नाम, मूल्यम्) {
    तुल्यम्(नाम, मूल्यम्, सत्यम्)।
}

# assert that a computation raises
विधि दोषः_भवति(नाम, विधिः) {
    _कृतानि = _कृतानि + १।
    मानय अभवत् = असत्यम्।
    प्रयत {
        विधिः()।
    } दोषे (त्रु) {
        अभवत् = सत्यम्।
    }
    यदि (अभवत्) {
        वद("  ✓", नाम)।
    } अन्यथा {
        _विफलानि = _विफलानि + १।
        वद("  ✗", नाम, "— दोषः अपेक्षितः आसीत्, न अभवत्")।
    }
}

# print the summary; returns सत्यम् when everything passed
विधि सारः() {
    वद("---")।
    यदि (_विफलानि == ०) {
        वद("सर्वाणि", _कृतानि, "परीक्षणानि सफलानि ✓")।
        फलम् सत्यम्।
    }
    वद(_विफलानि, "विफलानि,", _कृतानि, "कृतानि ✗")।
    फलम् असत्यम्।
}
