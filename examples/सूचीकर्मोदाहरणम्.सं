# सूचीकर्मोदाहरणम् — सूचीकर्म कोष्ठकस्य प्रयोगः।
# List operations: filter, map, reduce — the everyday shape of real data work.
#
# चालनम् / run:  sanskrita examples/सूचीकर्मोदाहरणम्.सं

आनय "सूचीकर्म" इति सू।

# ---- आधारः / the data ----
# विक्रयाणां सूची — मासस्य विक्रयाः (रुप्यकेषु)।
मानय विक्रयाः = [१२५०, ८९०, ३४७५, ६२०, २१००, ४५०, ५८००, १७३०]।

वद("सर्वे विक्रयाः:", विक्रयाः)।
वद("सङ्ख्या:", दैर्घ्यम्(विक्रयाः))।

# ---- योगः, महत्तमम्, लघुत्तमम् ----
वद("कुलयोगः:", सू.योगः(विक्रयाः))।
वद("महत्तमः:", सू.महत्तमम्(विक्रयाः))।
वद("लघुत्तमः:", सू.लघुत्तमम्(विक्रयाः))।
वद("माध्यम्:", सू.योगः(विक्रयाः) / दैर्घ्यम्(विक्रयाः))।

# ---- छानय / filter ----
# १००० तः अधिकाः विक्रयाः एव गृह्यन्ते।
मानय महान्तः = सू.छानय(विक्रयाः, विधि(व) { फलम् व > १०००। })।
वद("सहस्रात् अधिकाः:", महान्तः)।

# ---- प्रतिचित्रय / map ----
# प्रत्येकस्मिन् विक्रये ५ प्रतिशतं करः योज्यते।
मानय सकराः = सू.प्रतिचित्रय(विक्रयाः, विधि(व) { फलम् व + (व * ५) / १००। })।
वद("सकराः:", सकराः)।

# ---- न्यूनीकरण / reduce ----
# स्वयं योगं गणयितुम् — आरम्भः ० ।
मानय योगः = सू.न्यूनीकरण(विक्रयाः, विधि(सञ्चयः, व) { फलम् सञ्चयः + व। }, ०)।
वद("न्यूनीकरणेन योगः:", योगः)।

# ---- शृङ्खला / chaining ----
# १००० तः अधिकानां विक्रयाणां करसहितः योगः — एकस्मिन् वाक्ये।
वद("महतां सकरयोगः:",
   सू.योगः(सू.प्रतिचित्रय(महान्तः, विधि(व) { फलम् व + (व * ५) / १००। })))।

# ---- विपर्यय, अद्वितीयम्, अनुक्रमः, अन्तर्भवति ----
मानय नगराणि = ["काशी", "उज्जयिनी", "काशी", "पाटलिपुत्रम्", "उज्जयिनी"]।
वद("विपरीतम्:", सू.विपर्यय(नगराणि))।
वद("अद्वितीयानि:", सू.अद्वितीयम्(नगराणि))।
वद("'पाटलिपुत्रम्' स्थानम्:", सू.अनुक्रमः(नगराणि, "पाटलिपुत्रम्"))।
वद("'तक्षशिला' अस्ति वा:", सू.अन्तर्भवति(नगराणि, "तक्षशिला"))।

# अनुक्रमः प्रथमात् गणयति (१ तः) — अभावे ० ।
वद("'तक्षशिला' स्थानम् (अभावे ०):", सू.अनुक्रमः(नगराणि, "तक्षशिला"))।
