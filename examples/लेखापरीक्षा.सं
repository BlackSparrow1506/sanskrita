# लेखापरीक्षा — server log triage.
#
# The most ordinary job in operations: something is slow, here are the logs,
# find out what. No regex is used anywhere — वाक्यकर्म splitting is enough for
# a fixed log format, and it keeps this program runnable on BOTH engines.
#
# चालनम् / run:
#     sanskrita examples/लेखापरीक्षा.सं           # reference engine
#     sanskrita --veg examples/लेखापरीक्षा.सं     # native वेगः engine — same output

आनय "वाक्यकर्म"  इति वाक।
आनय "सूचीकर्म"   इति सू।
आनय "कालः"       इति का।
आनय "लेखनी"      इति ले।

# ---- आदानम् ----
# वास्तविके प्रयोगे: मानय कच्चम् = स.पठ("/var/log/सेवा.log")।
# In production this line would be स.पठ("/var/log/app.log"); the data is
# inlined here so the example runs anywhere and gives the same answer twice.
मानय कच्चम् = "२०२६-०७-२४ १०:१२:०३ सूचना /क्रयः २०० १४२
२०२६-०७-२४ १०:१२:०७ सूचना /सूची २०० ८९
२०२६-०७-२४ १०:१३:११ चेतावनी /क्रयः २०० १८४०
२०२६-०७-२४ १०:१४:०२ दोषः /देयम् ५०० ३२०५
२०२६-०७-२४ १०:१४:०९ सूचना /सूची २०० ७६
२०२६-०७-२५ ०९:०१:४४ दोषः /देयम् ५०० २९८७
२०२६-०७-२५ ०९:०२:१० चेतावनी /क्रयः २०० १६२०
२०२६-०७-२५ ०९:०३:५५ सूचना /क्रयः २०० १५५
२०२६-०७-२५ ०९:०५:२१ दोषः /सूची ५०३ ४४०
"।

# ---- विश्लेषणम् / parse ----
# प्रत्येका पङ्क्तिः: दिनाङ्कः समयः स्तरः मार्गः सङ्केतः कालः(ms)
विधि पङ्क्तिविश्लेषणम्(पङ्क्तिः) {
    मानय भागाः = वाक.विभज(पङ्क्तिः, " ")।
    यदि (दैर्घ्यम्(भागाः) != ६) {
        क्षिप वाक.आकारय("अशुद्धा पङ्क्तिः ({} भागाः): {}",
                        दैर्घ्यम्(भागाः), पङ्क्तिः)।
    }
    फलम् {
        "दिनाङ्कः": भागाः[१],
        "समयः":   भागाः[२],
        "स्तरः":   भागाः[३],
        "मार्गः":  भागाः[४],
        "सङ्केतः": सङ्ख्या(भागाः[५]),
        "कालः":   सङ्ख्या(भागाः[६]),
    }।
}

मानय अभिलेखाः = []।
मानय विफलाः = ०।
प्रत्येकम् पङ्क्तिः इति वाक.विभज(वाक.परिष्कार(कच्चम्), "\n") {
    प्रयत {
        योजय(अभिलेखाः, पङ्क्तिविश्लेषणम्(वाक.परिष्कार(पङ्क्तिः)))।
    } दोषे (त्रु) {
        # अशुद्धा पङ्क्तिः सम्पूर्णं कार्यं न नाशयेत् — गण्यते, लिख्यते, अग्रे गम्यते
        # One bad line must not kill the run: count it, log it, carry on.
        विफलाः = विफलाः + १।
        ले.चेतावनी("पङ्क्तिः त्यक्ता:", त्रु.सन्देशः)।
    }
}

वद("=== सारः ===")।
वद("अभिलेखाः :", दैर्घ्यम्(अभिलेखाः))।
वद("विफलाः   :", विफलाः)।
वद("")।

# ---- स्तरानुसारं गणना ----
मानय स्तरगणना = {}।
प्रत्येकम् अ इति अभिलेखाः {
    मानय स = अ["स्तरः"]।
    यदि (न कुञ्जिकाः(स्तरगणना).अन्तर्भवति(स)) { स्तरगणना[स] = ०। }
    स्तरगणना[स] = स्तरगणना[स] + १।
}
वद("=== स्तरानुसारम् ===")।
प्रत्येकम् स इति कुञ्जिकाः(स्तरगणना) {
    वद("  " + वाक.पूरय(स, १०) + वाक्यम्(स्तरगणना[स]))।
}
वद("")।

# ---- दोषाः एव ----
मानय दोषाः = सू.छानय(अभिलेखाः, विधि(अ) { फलम् अ["सङ्केतः"] >= ५००। })।
वद("=== विफलानि आह्वानानि ===")।
प्रत्येकम् अ इति दोषाः {
    वद(वाक.आकारय("  {} {} — {} ({} ms)",
                 अ["दिनाङ्कः"], अ["मार्गः"], अ["सङ्केतः"], अ["कालः"]))।
}
वद("")।

# ---- मन्दतमानि — क्रमय कुञ्जिकया ----
मानय मन्दाः = सू.क्रमय(अभिलेखाः, विधि(अ) { फलम् ०-अ["कालः"]। })।
वद("=== मन्दतमानि त्रीणि ===")।
मानय इ = १।
यावत् (इ <= ३) {
    मानय अ = मन्दाः[इ]।
    वद(वाक.आकारय("  {} ms — {} ({})", अ["कालः"], अ["मार्गः"], अ["दिनाङ्कः"]))।
    इ = इ + १।
}
वद("")।

# ---- मार्गानुसारं माध्यकालः ----
वद("=== मार्गानुसारं माध्यकालः ===")।
प्रत्येकम् म इति सू.अद्वितीयम्(सू.प्रतिचित्रय(अभिलेखाः, विधि(अ) { फलम् अ["मार्गः"]। })) {
    मानय तस्य = सू.छानय(अभिलेखाः, विधि(अ) { फलम् अ["मार्गः"] == म। })।
    मानय कालाः = सू.प्रतिचित्रय(तस्य, विधि(अ) { फलम् अ["कालः"]। })।
    वद("  " + वाक.पूरय(म, ८) +
       वाक.आकारय("n={}  माध्यम्={} ms  महत्तमम्={} ms",
                 दैर्घ्यम्(तस्य),
                 सू.योगः(कालाः) / दैर्घ्यम्(कालाः),
                 सू.महत्तमम्(कालाः)))।
}
वद("")।

# ---- दिनानुसारम् ----
वद("=== दिनानुसारम् ===")।
प्रत्येकम् द इति सू.अद्वितीयम्(सू.प्रतिचित्रय(अभिलेखाः, विधि(अ) { फलम् अ["दिनाङ्कः"]। })) {
    मानय तस्य = सू.छानय(अभिलेखाः, विधि(अ) { फलम् अ["दिनाङ्कः"] == द। })।
    मानय विफलानि = सू.छानय(तस्य, विधि(अ) { फलम् अ["सङ्केतः"] >= ५००। })।
    वद(वाक.आकारय("  {} ({})  आह्वानानि={}  विफलानि={}",
                 द, का.वासरः(द), दैर्घ्यम्(तस्य), दैर्घ्यम्(विफलानि)))।
}
