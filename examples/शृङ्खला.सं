# शृङ्खला — सन्धिवत् क्रियाशृङ्खला (method chaining).
#
# संस्कृतं यथा पदानि समस्यति, तथैव संस्कृता क्रियाः समस्यति।
# Sanskrit compounds words; संस्कृता compounds operations. `.नाम` on a
# सूची / वाक्यम् / कोशः is the SAME stdlib function you would call as
# सू.नाम(सूची, …) — one implementation, two spellings, whichever reads better.
#
# चालनम् / run:  sanskrita examples/शृङ्खला.सं

# ---- सूची-शृङ्खला ----
मानय अङ्काः = [७, ३, ९, ३, १, ९, ५]।

वद("मूलम्      :", अङ्काः)।
वद("क्रमितम्    :", अङ्काः.क्रमय())।
वद("विपरीतम्   :", अङ्काः.क्रमय().विपर्यय())।
वद("अद्वितीयम्  :", अङ्काः.अद्वितीयम्().क्रमय())।

# छानय → प्रतिचित्रय → योगः, एकस्मिन् वाक्ये
वद("पञ्चाधिकानां वर्गयोगः:",
   अङ्काः.छानय(विधि(क) { फलम् क > ५। })
         .प्रतिचित्रय(विधि(क) { फलम् क * क। })
         .योगः())।

वद("दैर्घ्यम्, महत्तमम्, लघुत्तमम्:",
   अङ्काः.दैर्घ्यम्(), अङ्काः.महत्तमम्(), अङ्काः.लघुत्तमम्())।

# ---- वाक्य-शृङ्खला ----
मानय पङ्क्तिः = "  रामः, सीता, लक्ष्मणः, हनुमान्  "।

वद("नामानि:", पङ्क्तिः.परिष्कार().विभज(", "))।
वद("सङ्ख्या:", पङ्क्तिः.परिष्कार().विभज(", ").दैर्घ्यम्())।
वद("उच्चम् :", "sanskrita".उच्च())।
वद("अस्ति वा:", पङ्क्तिः.अन्तर्भवति("सीता"))।

# ---- कोश-शृङ्खला ----
मानय आयुः = {"रामः": ३२, "सीता": २८, "लक्ष्मणः": ३०}।
वद("कुञ्जिकाः:", आयुः.कुञ्जिकाः())।
वद("कुञ्जिका-सङ्ख्या:", आयुः.कुञ्जिकाः().दैर्घ्यम्())।

# ---- उभयोः रूपयोः समम् एव फलम् ----
# शृङ्खला केवलं पठनसौकर्यार्थम्; कोष्ठक-रूपम् अपि तथैव कार्यं करोति।
आनय "सूचीकर्म" इति सू।
वद("शृङ्खलया  :", अङ्काः.अद्वितीयम्().योगः())।
वद("कोष्ठकेन  :", सू.योगः(सू.अद्वितीयम्(अङ्काः)))।
