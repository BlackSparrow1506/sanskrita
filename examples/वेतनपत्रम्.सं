# वेतनपत्रम् — a payroll run.
#
# This is the program संस्कृता was designed for. Money must be exact to the
# paisa; a bad row must be reported, not silently skipped; and the output has to
# be reproducible, because someone will audit it.
#
# चालनम् / run:
#     sanskrita examples/वेतनपत्रम्.सं
#     sanskrita --veg examples/वेतनपत्रम्.सं     # same digits, native engine

आनय "सारणी"    इति सा।
आनय "गणितम्"    इति ग।
आनय "सूचीकर्म"  इति सू।
आनय "वाक्यकर्म" इति वाक।
आनय "कालः"      इति का।
आनय "गूढ"       इति गू।
आनय "जेसन"      इति ज।
आनय "लेखनी"     इति ले।

ध्रुव मासः = "२०२६-०७"।

# ---- आदानम् / the input, as HR would export it ----
मानय आदानम् = "नाम,पदम्,मूलवेतनम्,प्रवेशदिनाङ्कः,दिनानि
आर्या शर्मा,अभियन्ता,८५०००.००,२०२२-०४-११,२२
रामः वर्मा,विश्लेषकः,६२५००.५०,२०१९-११-०१,२२
सीता नायर,प्रबन्धिका,१२४०००.००,२०१७-०६-२३,२०
मोहनः देसाई,प्रशिक्षुः,१८०००.००,२०२६-०७-०१,१५
कुसुमा राव,अभियन्ता,-५०००.००,२०२३-०१-०९,२२
हरिः पटेल,अभियन्ता,७१०००.००,कदापि,२२
"।

# ---- नियमाः / the rules, in one place where an auditor can read them ----
ध्रुव कार्यदिनानि = २२।
ध्रुव भविष्यनिधिः = १२।        # प्रतिशतम्
ध्रुव व्यावसायिककरः = २००।     # स्थिरम्

विधि करप्रतिशतम्(वार्षिकम्) {
    यदि (वार्षिकम् <= ३०००००) { फलम् ०। }
    यदि (वार्षिकम् <= ७०००००) { फलम् ५। }
    यदि (वार्षिकम् <= १२०००००) { फलम् २०। }
    फलम् ३०।
}

# ---- परीक्षणम् / validate, with a REASON for every rejection ----
विधि परीक्ष(पङ्क्तिः) {
    यदि (वाक.परिष्कार(पङ्क्तिः["नाम"]) == "") {
        क्षिप "नाम रिक्तम्"।
    }
    यदि (न का.शुद्धः(पङ्क्तिः["प्रवेशदिनाङ्कः"])) {
        क्षिप वाक.आकारय("प्रवेशदिनाङ्कः अशुद्धः: {}", पङ्क्तिः["प्रवेशदिनाङ्कः"])।
    }
    मानय वेतनम् = सङ्ख्या(पङ्क्तिः["मूलवेतनम्"])।
    यदि (वेतनम् <= ०) {
        क्षिप वाक.आकारय("मूलवेतनम् ऋणात्मकम् वा शून्यम्: {}", वेतनम्)।
    }
    फलम् सत्यम्।
}

# ---- गणना / the calculation ----
विधि वेतनगणना(पङ्क्तिः) {
    मानय मूलम् = सङ्ख्या(पङ्क्तिः["मूलवेतनम्"])।
    मानय दिनानि = सङ्ख्या(पङ्क्तिः["दिनानि"])।

    # आनुपातिकं वेतनम् — दिनानुसारम्।
    # प्रत्येकं धनमूल्यं पैसापर्यन्तं परिवर्त्यते — इदमेव वस्तुतः दीयते।
    # Every money value is rounded to the paisa at the moment it becomes money.
    # Rounding once, here, is why the totals below reconcile exactly.
    मानय उपार्जितम् = ग.परिवृत्त((मूलम् * दिनानि) / कार्यदिनानि, २)।

    मानय निधिः = ग.परिवृत्त((उपार्जितम् * भविष्यनिधिः) / १००, २)।
    मानय करः = ग.परिवृत्त(
        (उपार्जितम् * करप्रतिशतम्(मूलम् * १२)) / १००, २)।
    मानय कटौती = ग.परिवृत्त(निधिः + करः + व्यावसायिककरः, २)।

    फलम् {
        "नाम": पङ्क्तिः["नाम"],
        "पदम्": पङ्क्तिः["पदम्"],
        "उपार्जितम्": उपार्जितम्,
        "निधिः": निधिः,
        "करः": करः,
        "कटौती": कटौती,
        "निवलम्": ग.परिवृत्त(उपार्जितम् - कटौती, २),
        "सेवावर्षाणि": ग.परिवृत्त(का.अन्तरम्(पङ्क्तिः["प्रवेशदिनाङ्कः"], "२०२६-०७-३१") / ३६५, १),
    }।
}

# ---- चालनम् ----
मानय पङ्क्तयः = सा.कोशाः(आदानम्)।
मानय पत्राणि = []।
मानय त्यक्ताः = []।

प्रत्येकम् प इति पङ्क्तयः {
    प्रयत {
        परीक्ष(प)।
        योजय(पत्राणि, वेतनगणना(प))।
    } दोषे (त्रु) {
        # प्रकारः इति ज्ञातेन कारणेन भेदः — स्वयंदोषः इति अस्माकं नियमभङ्गः,
        # अन्यत् किमपि इति अनपेक्षितम्।
        # The kind tells us whose fault it is: स्वयंदोषः is OUR rule failing,
        # anything else is a surprise and must not be quietly absorbed.
        यदि (त्रु.प्रकारः != "स्वयंदोषः") { क्षिप त्रु। }
        योजय(त्यक्ताः, {"नाम": प["नाम"], "कारणम्": त्रु.सन्देशः})।
        ले.चेतावनी("पङ्क्तिः त्यक्ता:", प["नाम"], "—", त्रु.सन्देशः)।
    }
}

# ---- वेतनपत्रम् ----
वद(वाक.आकारय("=== वेतनपत्रम् {} ===", मासः))।
वद("")।
वद(वाक.पूरय("नाम", १६) + वाक.पूरय("पदम्", १२) +
   वाक.पूरय("उपार्जितम्", ०-१४) + वाक.पूरय("कटौती", ०-१३) +
   वाक.पूरय("निवलम्", ०-१४))।
वद("───────────────────────────────────────────────────────────────────")।

प्रत्येकम् प इति सू.क्रमय(पत्राणि, विधि(प) { फलम् ०-प["निवलम्"]। }) {
    वद(वाक.पूरय(प["नाम"], १६) +
       वाक.पूरय(प["पदम्"], १२) +
       वाक.पूरय(वाक्यम्(प["उपार्जितम्"]), ०-१४) +
       वाक.पूरय(वाक्यम्(प["कटौती"]), ०-१३) +
       वाक.पूरय(वाक्यम्(प["निवलम्"]), ०-१४))।
}
वद("")।

# ---- योगाः — यत्र शुद्धिः वस्तुतः महत्त्वं धारयति ----
# यदि एते प्लवाः स्युः, तर्हि योगः पैसामात्रेण भ्रश्येत् — प्रतिमासम्।
# With binary floats these totals would drift by a paisa — every single month.
मानय उपार्जितानि = सू.प्रतिचित्रय(पत्राणि, विधि(प) { फलम् प["उपार्जितम्"]। })।
मानय निवलानि = सू.प्रतिचित्रय(पत्राणि, विधि(प) { फलम् प["निवलम्"]। })।
मानय कटौत्यः = सू.प्रतिचित्रय(पत्राणि, विधि(प) { फलम् प["कटौती"]। })।

वद(वाक.पूरय("नाम", १६) + वाक.पूरय("सेवावर्षाणि", ०-१२))।
प्रत्येकम् प इति सू.क्रमय(पत्राणि, विधि(प) { फलम् ०-प["सेवावर्षाणि"]। }) {
    वद(वाक.पूरय(प["नाम"], १६) + वाक.पूरय(वाक्यम्(प["सेवावर्षाणि"]), ०-१२))।
}
वद("")।

वद("कर्मचारिणः      :", दैर्घ्यम्(पत्राणि))।
वद("कुलम् उपार्जितम् :", सू.योगः(उपार्जितानि))।
वद("कुला कटौती      :", सू.योगः(कटौत्यः))।
वद("कुलं निवलम्      :", सू.योगः(निवलानि))।
वद("मेलनम् (शुद्धम्)  :",
   सू.योगः(उपार्जितानि) - सू.योगः(कटौत्यः) == सू.योगः(निवलानि))।
वद("")।

# ---- त्यक्ताः — मौनं न, प्रतिवेदनम् ----
वद("=== त्यक्ताः पङ्क्तयः ===")।
यदि (दैर्घ्यम्(त्यक्ताः) == ०) {
    वद("  (न काचित्)")।
}
प्रत्येकम् त इति त्यक्ताः {
    वद("  " + वाक.पूरय(त["नाम"], १६) + त["कारणम्"])।
}
वद("")।

# ---- निर्गमः: लेखापालाय CSV, यन्त्राय JSON ----
मानय सारणीनिर्गमः = [["नाम", "उपार्जितम्", "कटौती", "निवलम्"]] +
    सू.प्रतिचित्रय(पत्राणि, विधि(प) {
        फलम् [प["नाम"], वाक्यम्(प["उपार्जितम्"]),
              वाक्यम्(प["कटौती"]), वाक्यम्(प["निवलम्"])]।
    })।

वद("=== CSV (लेखापालाय) ===")।
वद(सा.पाठय(सारणीनिर्गमः))।

मानय सारः = {
    "मासः": मासः,
    "कर्मचारिणः": दैर्घ्यम्(पत्राणि),
    "त्यक्ताः": दैर्घ्यम्(त्यक्ताः),
    "कुलं_निवलम्": सू.योगः(निवलानि),
}।
मानय पत्रम् = ज.पाठय(सारः)।
वद("=== JSON (यन्त्राय) ===")।
वद(पत्रम्)।

# ---- लेखापरीक्षा-चिह्नम् ----
# समानम् आदानं समानं चिह्नं ददाति। यदि चिह्नं भिन्नम्, तर्हि किमपि परिवर्तितम् —
# एतदेव लेखापालः पृच्छति।
# The same input always gives the same digest. If it differs, something changed
# — which is exactly the question an auditor asks.
वद("")।
वद("चिह्नम् (SHA-256):", गू.सङ्क्षेपः(पत्रम्))।
