# शुद्धिवेगौ — शुद्धिः वेगः च (exactness and speed), and default arguments.
#
# अन्याः भाषाः द्विमानप्लवं (binary float) पूर्वनिर्धारितं ददति — ततः
# ०.१ + ०.२ ≠ ०.३। संस्कृता विपरीतं करोति: शुद्धः दशमांशः पूर्वनिर्धारितः,
# द्रुतः प्लवः केवलं याचितः।
#
# Other languages hand you a binary float by default, so 0.1 + 0.2 misses 0.3.
# संस्कृता flips it: the exact दशमांशः is the default, and the fast binary
# float is something you must ask for by name. Nothing is hidden either way.
#
# चालनम् / run:  sanskrita examples/शुद्धिवेगौ.सं

वद("=== शुद्धः दशमांशः (पूर्वनिर्धारितः) ===")।
वद("०.१ + ०.२       =", ०.१ + ०.२)।
वद("०.३ इति समम् वा =", ०.१ + ०.२ == ०.३)।
वद("प्रकारः          =", प्रकारः(०.१ + ०.२))।

# धनगणना — यत्र एकः अपि अंशः न नश्येत्
मानय मूल्यम् = ४५०.५०।
मानय करः = ८१.०९।
मानय शुल्कम् = ४०.००।
वद("कुलम्            =", मूल्यम् + करः + शुल्कम्)।

वद("")।
वद("=== द्रुतदशमांशः (याचितः) ===")।
मानय अ = द्रुतदशमांशः(०.१)।
मानय ब = द्रुतदशमांशः(०.२)।
वद("अ + ब           =", अ + ब)।
वद("प्रकारः          =", प्रकारः(अ + ब))।
वद("२ / ३           =", द्रुतदशमांशः(२) / ३)।

# सङ्क्रामकः — एकोऽपि द्रुतदशमांशः सर्वं द्रुतं करोति
वद("अ + ०.२         =", अ + ०.२, "(", प्रकारः(अ + ०.२), ")")।

वद("")।
वद("=== कदा किम् ===")।
वद("धनम्, मापनम्, अङ्काः  → दशमांशः (शुद्धिः आवश्यकी)")।
वद("आलेखः, अनुकरणम्, ML → द्रुतदशमांशः (वेगः आवश्यकः)")।

वद("")।
वद("=== पूर्वनिर्धारितानि मूल्यानि (default arguments) ===")।

# ख इत्यस्य मूल्यम् अदत्तं चेत् ५ गृह्यते
विधि योजनम्(क, ख = ५) { फलम् क + ख। }
वद("योजनम्(१)      =", योजनम्(१))।
वद("योजनम्(१, १०)  =", योजनम्(१, १०))।

# कारकैः सह अपि
विधि अभिवादय(कर्म नाम, करण भाषा = "संस्कृतम्") {
    फलम् नाम + " — " + भाषा।
}
वद(अभिवादय(कर्म: "गौरी"))।
वद(अभिवादय(करण: "हिन्दी", कर्म: "गौरी"))।

# पूर्वनिर्धारितं मूल्यं प्रतिवारं नवीनं गण्यते — अतः पैथन्-दोषः अत्र नास्ति
विधि सङ्ग्रह(म, सूचिः = []) { योजय(सूचिः, म)। फलम् सूचिः। }
वद("प्रथमवारम् :", सङ्ग्रह(१))।
वद("द्वितीयवारम्:", सङ्ग्रह(२))।
