# दोषविवरणम् — errors you can actually work with.
#
# An error message that only says "something went wrong on line 3" is true and
# almost useless in a program of any size. Here an error is a *value*: it knows
# its kind, its line, both its messages, and the whole chain of विधिs it came
# through — so you can branch on it, log it, or pass it on unchanged.
#
# चालनम् / run:  sanskrita examples/दोषविवरणम्.सं

आनय "वाक्यकर्म" इति वाक।

वद("=== १. दोषः वस्तु अस्ति, न केवलं वाक्यम् ===")।

प्रयत {
    वद(१ / ०)।
} दोषे (त्रु) {
    वद("मुद्रणे    :", त्रु)।                 # प्रिन्ट् करने पर सन्देश ही दिखता है
    वद("सन्देशः    :", त्रु.सन्देशः)।
    वद("आङ्ग्ले    :", त्रु.आङ्ग्लसन्देशः)।
    वद("पङ्क्तिः    :", त्रु.पङ्क्तिः)।
    वद("प्रकारः    :", त्रु.प्रकारः)।
}
वद("")।

वद("=== २. प्रकारभेदेन भिन्नं प्रतिकर्म ===")।
# यही असली कारण है कि दोषस्य प्रकारः आवश्यकः — एकं ग्रहणं, भिन्नानि कार्याणि।
# This is the whole point of a kind: one catch, different responses.

विधि सुरक्षितम्(कार्यम्) {
    प्रयत {
        फलम् कार्यम्()।
    } दोषे (त्रु) {
        यदि (त्रु.प्रकारः == "गणितदोषः") {
            फलम् "गणितदोषः — मूल्यं शून्यम् इति गृह्यते"।
        }
        यदि (त्रु.प्रकारः == "सीमादोषः") {
            फलम् "सीमादोषः — सूची तावती दीर्घा नास्ति"।
        }
        यदि (त्रु.प्रकारः == "नामदोषः") {
            फलम् "नामदोषः — किमपि अघोषितम्"।
        }
        # यत् न जानीमः तत् न गिलामः — पुनः क्षिपामः
        # What we do not understand, we do not swallow: re-raise it.
        क्षिप त्रु।
    }
}

वद(सुरक्षितम्(विधि() { फलम् १० / ०। }))।
वद(सुरक्षितम्(विधि() { मानय स = [१, २]। फलम् स[९]। }))।
वद(सुरक्षितम्(विधि() { फलम् अनुपस्थितम्। }))।
वद(सुरक्षितम्(विधि() { फलम् ४२। }))।
वद("")।

वद("=== ३. अनुरेखा — दोषः कुतः आगतः ===")।
# पञ्चस्तरीये आह्वाने केवला अन्तिमा पङ्क्तिः न पर्याप्ता।
# In a five-deep call chain, the innermost line alone tells you nothing.

विधि वेतनम्(कर्मी)   { फलम् करः(कर्मी)। }
विधि करः(कर्मी)      { फलम् प्रतिशतम्(कर्मी["वेतनम्"], कर्मी["करः"])। }
विधि प्रतिशतम्(अ, ब) { फलम् (अ * ब) / ०। }        # दोषः अत्र

प्रयत {
    वेतनम्({"वेतनम्": ५००००, "करः": १०})।
} दोषे (त्रु) {
    वद("दोषः      :", त्रु)।
    वद("पङ्क्तिः    :", त्रु.पङ्क्तिः)।
    वद("अनुरेखा   :", त्रु.अनुरेखा)।
    प्रत्येकम् चरणम् इति त्रु.अनुरेखा {
        वद("   ↳", चरणम्)।
    }
}
वद("")।

वद("=== ४. स्वकीयाः दोषाः ===")।
# क्षिप स्वयंदोषः इति प्रकारं ददाति — अतः स्वकीयान् दोषान् पृथक् ज्ञातुं शक्यते।

विधि आयुःपरीक्षा(आयुः) {
    यदि (आयुः < ०) { क्षिप "आयुः ऋणात्मकः न भवेत्"। }
    यदि (आयुः > १५०) { क्षिप "आयुः अतिमहान्"। }
    फलम् सत्यम्।
}

प्रत्येकम् अ इति [२५, ०-५, २००] {
    प्रयत {
        आयुःपरीक्षा(अ)।
        वद(वाक.आकारय("{} — शुद्धम् ✓", अ))।
    } दोषे (त्रु) {
        वद(वाक.आकारय("{} — {} ({})", अ, त्रु.सन्देशः, त्रु.प्रकारः))।
    }
}
वद("")।

वद("=== ५. न गृहीतः दोषः ===")।
वद("यदि कोऽपि न गृह्णाति, तर्हि सम्पूर्णा अनुरेखा मुद्र्यते —")।
वद("प्रयत्नं कुरु: एतस्य सञ्चिकायाः अन्ते टिप्पणीं निष्कासय।")।

# निम्नलिखितं मुक्तं चेत् सम्पूर्णा अनुरेखा दृश्यते:
# वेतनम्({"वेतनम्": ५००००, "करः": १०})।
