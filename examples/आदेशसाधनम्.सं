# आदेशसाधनम् — a real command-line tool.
#
# Not a demo that prints things: a utility you could put in a cron job. It reads
# arguments, honours an environment variable, writes its report to stdout and
# its complaints to stderr, and exits with a status code the shell can branch
# on. That last part is what separates a script from a toy.
#
# चालनम् / run:
#     sanskrita examples/आदेशसाधनम्.सं                     # usage
#     sanskrita examples/आदेशसाधनम्.सं examples            # count a folder
#     sanskrita examples/आदेशसाधनम्.सं examples .सं        # only .सं files
#     sanskrita --veg examples/आदेशसाधनम्.सं examples      # native engine
#
#     SANSKRITA_VERBOSE=1 sanskrita examples/आदेशसाधनम्.सं examples
#     echo $?     # ० सफलम् · १ अशुद्धः प्रयोगः · २ सूचिका न प्राप्ता

आनय "सञ्चिका"    इति स।
आनय "सूचीकर्म"   इति सू।
आनय "वाक्यकर्म"  इति वाक।
आनय "गणितम्"     इति ग।
आनय "परिवेशः"    इति प।
आनय "लेखनी"      इति ले।

ध्रुव नाम = "सञ्चिकागणकः"।
ध्रुव संस्करणम् = "१.०"।

# ---- सङ्केताः / exit codes, named once ----
ध्रुव सफलम् = ०।
ध्रुव अशुद्धप्रयोगः = १।
ध्रुव सूचिकादोषः = २।

विधि प्रयोगः() {
    प.दोषवद(वाक.आकारय("{} {} — सूचिकायाः सञ्चिकाः गणयति", नाम, संस्करणम्))।
    प.दोषवद("")।
    प.दोषवद("प्रयोगः:")।
    प.दोषवद("  सञ्चिकागणकः <सूचिका> [प्रत्ययः]")।
    प.दोषवद("")।
    प.दोषवद("उदाहरणम्:")।
    प.दोषवद("  सञ्चिकागणकः examples .सं")।
    प.दोषवद("")।
    प.दोषवद("परिवेशः:")।
    प.दोषवद("  SANSKRITA_VERBOSE=1   विस्तृतं विवरणम्")।
}

# ---- मुख्यम् ----
मानय चराः = आदेशचराः()।

# विस्तृतता परिवेशात् — आदेशपङ्क्तिः स्वच्छा तिष्ठति
यदि (प.चरः("SANSKRITA_VERBOSE", "") != "") {
    ले.स्तरः("विवरणम्")।
    ले.विवरणम्("विस्तृतः प्रकारः सक्रियः")।
}

यदि (दैर्घ्यम्(चराः) == ०) {
    प्रयोगः()।
    प.निर्गम(अशुद्धप्रयोगः)।
}

मानय सूचिका = चराः[१]।
मानय प्रत्ययः = ""।
यदि (दैर्घ्यम्(चराः) >= २) { प्रत्ययः = चराः[२]। }

ले.विवरणम्("सूचिका:", सूचिका, "प्रत्ययः:", प्रत्ययः)।

यदि (न स.अस्ति(सूचिका)) {
    प.दोषवद(वाक.आकारय("दोषः: '{}' इति सूचिका न प्राप्ता", सूचिका))।
    प.निर्गम(सूचिकादोषः)।
}

मानय सर्वाणि = []।
प्रयत {
    सर्वाणि = स.सूचिका(सूचिका)।
} दोषे (त्रु) {
    # प्रकारेण भेदः — अनपेक्षितं किमपि न गिलामः
    प.दोषवद("दोषः:", त्रु.सन्देशः)।
    प.निर्गम(सूचिकादोषः)।
}

मानय नामानि = सर्वाणि।
यदि (प्रत्ययः != "") {
    नामानि = सू.छानय(सर्वाणि, विधि(सं) { फलम् वाक.अन्तयति(सं, प्रत्ययः)। })।
}

# ---- प्रतिवेदनम् — stdout, यत् अन्यत्र नेतुं शक्यम् ----
वद(वाक.आकारय("सूचिका : {}", सूचिका))।
यदि (प्रत्ययः != "") {
    वद(वाक.आकारय("प्रत्ययः: {}", प्रत्ययः))।
}
वद(वाक.आकारय("सङ्ख्या : {} / {}", दैर्घ्यम्(नामानि), दैर्घ्यम्(सर्वाणि)))।

यदि (दैर्घ्यम्(नामानि) == ०) {
    ले.चेतावनी("एकापि सञ्चिका न मेलति")।
    प.निर्गम(सफलम्)।
}

# ---- आकारानुसारं दश महत्तमाः ----
मानय विवरणानि = []।
प्रत्येकम् सं इति नामानि {
    मानय मार्गः = सूचिका + "/" + सं।
    प्रयत {
        मानय पङ्क्तयः = स.पङ्क्तयः(मार्गः)।
        योजय(विवरणानि, {"नाम": सं, "पङ्क्तयः": दैर्घ्यम्(पङ्क्तयः)})।
    } दोषे (त्रु) {
        # सूचिका वा अपठनीया सञ्चिका — सूच्यते, न तु कार्यं भज्यते
        ले.विवरणम्("त्यक्ता:", सं, "—", त्रु.सन्देशः)।
    }
}

वद("")।
वद(वाक.पूरय("सञ्चिका", ३०) + वाक.पूरय("पङ्क्तयः", ०-९))।
वद("───────────────────────────────────────")।
मानय क्रमिताः = सू.क्रमय(विवरणानि, विधि(व) { फलम् ०-व["पङ्क्तयः"]। })।
मानय इ = १।
यावत् (इ <= १० च इ <= दैर्घ्यम्(क्रमिताः)) {
    मानय व = क्रमिताः[इ]।
    वद(वाक.पूरय(व["नाम"], ३०) + वाक.पूरय(वाक्यम्(व["पङ्क्तयः"]), ०-९))।
    इ = इ + १।
}

मानय कुलम् = सू.योगः(सू.प्रतिचित्रय(विवरणानि, विधि(व) { फलम् व["पङ्क्तयः"]। }))।
वद("")।
वद(वाक.आकारय("कुलाः पङ्क्तयः : {}", कुलम्))।
वद(वाक.आकारय("माध्यम्        : {}",
             ग.परिवृत्त(कुलम् / दैर्घ्यम्(विवरणानि), १)))।

ले.सूचना("कार्यं सम्पन्नम्")।
प.निर्गम(सफलम्)।
