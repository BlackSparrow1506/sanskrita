# जेसनोदाहरणम् — जेसन (JSON) कोष्ठकस्य प्रयोगः।
# JSON is how the world's programs talk to each other. संस्कृता reads and
# writes it — and, unlike most languages, a decimal survives the round trip
# without losing a digit, because it never becomes a float.
#
# चालनम् / run:  sanskrita examples/जेसनोदाहरणम्.सं

आनय "जेसन" इति ज।
आनय "सूचीकर्म" इति सू।

# ---- लेखनम् / stringify ----
मानय छात्रः = {"नाम": "आर्या", "वर्षः": १९, "अङ्काः": [८८, ९२, ७९]}।
मानय पाठः = ज.पाठय(छात्रः)।
वद("जेसन-पाठः:", पाठः)।

# ---- पठनम् / parse ----
मानय पुनः = ज.विश्लेषय(पाठः)।
वद("नाम:", पुनः["नाम"])।
वद("अङ्कयोगः:", सू.योगः(पुनः["अङ्काः"]))।

# ---- शुद्धदशमांशः / the exactness that matters ----
# अन्येषु भाषासु 0.1 + 0.2 इति 0.30000000000000004 भवति।
# संस्कृतायां जेसन-दशमांशः दशमांशः एव तिष्ठति, न तु प्लवः।
मानय मूल्यम् = ज.विश्लेषय("{\"शुल्कम्\": 0.1, \"करः\": 0.2}")।
वद("शुल्कम् + करः =", मूल्यम्["शुल्कम्"] + मूल्यम्["करः"])।
वद("०.३ इति समम् वा:", मूल्यम्["शुल्कम्"] + मूल्यम्["करः"] == ०.३)।
वद("प्रकारः:", प्रकारः(मूल्यम्["शुल्कम्"]))।

# ---- सूची, सत्यासत्यम्, शून्यम् — सर्वं समर्थितम् ----
मानय मिश्रम् = ज.विश्लेषय("[1, 2.5, true, null, \"क\"]")।
वद("मिश्रम्:", मिश्रम्)।
वद("पुनः पाठितम्:", ज.पाठय(मिश्रम्))।

# ---- दोषनिवारणम् / bad input is an error you can catch ----
प्रयत {
    मानय दुष्टम् = ज.विश्लेषय("{अ}")।
    वद("एतत् न भवेत्")।
} दोषे (त्रु) {
    वद("अशुद्धं जेसन गृहीतम् ✓")।
}
